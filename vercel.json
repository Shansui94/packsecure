{
    "functions": {
        "api/**/*.ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/nightly-report",
            "schedule": "0 14 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/agent/universal-intake",
            "destination": "/api/agent/universal?action=intake"
        },
        {
            "source": "/api/agent/universal-query",
            "destination": "/api/agent/universal?action=query"
        },
        {
            "source": "/api/agent/parse-text",
            "destination": "/api/agent/universal?action=parse-text"
        },
        {
            "source": "/api/agent/parse-trip-pdf",
            "destination": "/api/agent/universal?action=parse-trip-pdf"
        },
        {
            "source": "/api/agent/omni-command",
            "destination": "/api/agent/universal?action=omni-command"
        },
        {
            "source": "/api/machines",
            "destination": "/api/iot-config?action=machines"
        },
        {
            "source": "/api/v2/documents/(.*)",
            "destination": "/api/v2-documents?action=$1"
        },
        {
            "source": "/api/v2/documents",
            "destination": "/api/v2-documents"
        },
        {
            "source": "/api/agent/sop-assistant",
            "destination": "/api/agent/universal?action=sop-assistant"
        },
        {
            "source": "/api/dev-log",
            "destination": "/api/docs?action=dev-log"
        },
        {
            "source": "/api/whatsapp/send",
            "destination": "/api/whatsapp?action=send"
        },
        {
            "source": "/api/whatsapp/webhook",
            "destination": "/api/whatsapp"
        },
        {
            "source": "/api/alarm",
            "destination": "/api/iot-config?action=alarm"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
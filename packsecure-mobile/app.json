{
  "expo": {
    "name": "Packsecure OS Mobile",
    "slug": "packsecure-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.packsecure.os",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Packsecure 需要后台 GPS 权限以在司机送货过程中实时追踪行驶轨迹。",
        "NSLocationWhenInUseUsageDescription": "Packsecure 需要获取您当前的 GPS 位置以完成送货与考勤打卡。",
        "NSCameraUsageDescription": "Packsecure 需要相机权限以拍照上传 POD 送货凭证与扫描机台二维码。"
      }
    },
    "android": {
      "package": "com.packsecure.os",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "允许 Packsecure 在后台记录司机送货行驶轨迹。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Packsecure 使用相机拍摄 POD 送货单或扫描机台二维码。"
        }
      ],
      "expo-sqlite"
    ]
  }
}

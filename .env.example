# Copy this file to ".env" in the same folder (packsecure/) and fill in real values.
# Never commit ".env" — it contains secrets.
#
# Local full stack (Vite + Express AI):  npm run dev:all
# Frontend only:                          npm run dev

# --- Required for the web app (Vite exposes only VITE_* to the browser) ---
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# --- Optional: local AI chat (npm run start → Express on :8080) ---
# Same Supabase project → service_role key (bypasses RLS; keep local only)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio / Cloud key for Gemini (api/agent/chat.ts)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Optional: HR Portal builds an admin client in the browser (avoid in production) ---
# VITE_SUPABASE_SERVICE_ROLE_KEY=

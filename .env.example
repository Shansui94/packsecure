# Copy this file to ".env" in the same folder (packsecure/) and fill in real values.
# Never commit ".env" — it contains secrets.
#
# Local full stack (Vite + Express AI):  npm run dev:all
# Frontend only:                          npm run dev

# --- Required for the web app (Vite exposes only VITE_* to the browser) ---
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# --- Server only (Vercel + npm run start). NEVER use VITE_ prefix for service role. ---
SUPABASE_SERVICE_ROLE_KEY=
# Vercel serverless: also set SUPABASE_URL (same value as VITE_SUPABASE_URL) — VITE_* may not reach API at runtime
SUPABASE_URL=

# Optional: production site URL for admin API CORS (e.g. https://your-app.vercel.app)
# SITE_URL=

# Google AI Studio / Cloud key for Gemini (api/agent/chat.ts)
GOOGLE_API_KEY=
# GEMINI_API_KEY=
